APP_ENV=development
PROJECT_NAME=PawLine
# Fake development credential for the legacy CRM mock service; not a real secret.
MOCK_CRM_API_KEY=dev-crm-key
LEGACY_CRM_BASE_URL=http://127.0.0.1:8001
# Fake local-development credential for the outbound PawLine CRM client; not a real secret.
LEGACY_CRM_API_KEY=dev-crm-key
# Fake local-development JWT secret for the scheduling mock service; not a real secret.
MOCK_SCHEDULER_JWT_SECRET=dev-scheduler-secret
# Fake local-development JWT secret for the PawLine scheduler client; must match the mock scheduler secret.
SCHEDULER_BASE_URL=http://127.0.0.1:8002
SCHEDULER_JWT_SECRET=dev-scheduler-secret
# Fake local-development webhook secret for the mock human handoff service; not a real secret.
MOCK_HANDOFF_WEBHOOK_SECRET=dev-handoff-secret
# Fake local-development webhook secret for the PawLine handoff client; must match the mock handoff secret.
HANDOFF_BASE_URL=http://127.0.0.1:8003
HANDOFF_WEBHOOK_SECRET=dev-handoff-secret
