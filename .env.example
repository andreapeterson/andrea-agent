# Copy to .env only if you do not already have one.
# Enter real credentials in .env locally; never share that file or paste values in chat.
# Retrieve OPENAI_API_KEY from Infisical Development (dev), path /.
INFISICAL_CLIENT_ID=replace-with-agent-demo-app-client-id
INFISICAL_CLIENT_SECRET=replace-with-agent-demo-app-client-secret
INFISICAL_PROJECT_ID=replace-with-agent-demo-project-id

# Existing app and mock-service credentials; use matching values for each pair.
LEGACY_CRM_API_KEY=replace-with-local-crm-key
MOCK_CRM_API_KEY=replace-with-the-same-local-crm-key
SCHEDULER_JWT_SECRET=replace-with-a-local-secret-at-least-32-bytes
MOCK_SCHEDULER_JWT_SECRET=replace-with-the-same-local-scheduler-secret
HANDOFF_WEBHOOK_SECRET=replace-with-local-handoff-secret
MOCK_HANDOFF_WEBHOOK_SECRET=replace-with-the-same-local-handoff-secret

# Optional overrides; omit these to use the app defaults.
# LEGACY_CRM_BASE_URL=replace-with-local-crm-url
# SCHEDULER_BASE_URL=replace-with-local-scheduler-url
# HANDOFF_BASE_URL=replace-with-local-handoff-url
# OPENAI_ROUTER_MODEL=replace-with-model-name
# OPENAI_SPECIALIST_MODEL=replace-with-model-name
# OPENAI_EMBEDDING_MODEL=replace-with-model-name
# OPENAI_POLICY_MODEL=replace-with-model-name
# POLICY_MIN_SIMILARITY=replace-with-similarity-threshold
# POLICY_TOP_K=replace-with-result-count
